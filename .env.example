NODE_ENV=development
API_PREFIX=

#* Levels: fatal | error | warn | log | debug | verbose
LOG_LEVEL=verbose

#* In kilobytes (for better experience in real app, set 10240 — 10mb)
LOG_MAX_FILE_SIZE=1024

#* Show db logs (true/false)
DB_LOGS=false
#* Max number of connections in the pool
DB_POOL_MAX=20
#* Time in ms before an idle connection is closed
DB_POOL_IDLE_TIMEOUT=30000
#* Time in ms to wait for a connection before timeout
DB_POOL_CONNECTION_TIMEOUT=2000
#* Max number of times a connection can be used before being replaced
DB_POOL_MAX_USES=7500

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300

RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://vectordb:6333
