{
	"name": "knowledge-hub",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24.10.0"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"dev": "nest start --watch",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test:base": "cross-env TEST_MODE=auth jest --testMatch \"<rootDir>/*.spec.ts\" --noStackTrace --runInBand --forceExit",
		"test:pagination": "cross-env TEST_MODE=auth jest pagination --noStackTrace --runInBand --forceExit",
		"test:auth": "cross-env TEST_MODE=auth jest auth --testPathIgnorePatterns \"refresh|rbac\" --noStackTrace --runInBand --forceExit",
		"test:refresh": "cross-env TEST_MODE=auth jest refresh --noStackTrace --runInBand --forceExit",
		"test:rbac": "cross-env TEST_MODE=auth jest rbac --noStackTrace --runInBand --forceExit",
		"test:jest": "cross-env TEST_MODE=auth jest --noStackTrace --runInBand --forceExit",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest run --watch",
		"test:coverage": "vitest run --coverage",
		"test:coverage:watch": "vitest run --coverage --watch",
		"test": "npm run test:unit && npm run test:jest",
		"docker:down": "docker compose down -v",
		"docker:rebuild": "docker compose up --build",
		"docker:up": "docker compose up -d",
		"docker:db": "docker compose up db -d",
		"docker:db:logs": "docker compose logs -f db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push:dev-only": "drizzle-kit push",
		"db:seed": "tsx src/drizzle/db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:wait": "tsx scripts/wait-db.ts",
		"db:setup": "npm run db:migrate && npm run db:seed",
		"db:reset": "npm run docker:down && npm run docker:db && npm run db:wait && npm run db:setup",
		"db:clean-start": "npm run db:reset && npm run db:studio",
		"prepare": "husky"
	},
	"dependencies": {
		"@nestjs/common": "^10.4.16",
		"@nestjs/config": "^4.0.3",
		"@nestjs/core": "^10.4.15",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/platform-express": "^10.4.15",
		"@nestjs/swagger": "^8.1.1",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.5.0",
		"@scalar/nestjs-api-reference": "^1.1.6",
		"bcrypt": "^5.1.1",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^1.0.0-beta.22",
		"http-status-codes": "^2.2.0",
		"nestjs-pino": "^4.6.1",
		"nestjs-zod": "^5.3.0",
		"pg": "^8.20.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.1",
		"rimraf": "^5.0.5",
		"rxjs": "^7.8.1",
		"uuid": "^9.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.0.3",
		"@nestjs/testing": "^10.2.8",
		"@types/bcrypt": "^5.0.2",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.12",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/node": "^20.11.24",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.2",
		"@types/uuid": "^9.0.8",
		"@typescript-eslint/eslint-plugin": "^7.1.1",
		"@typescript-eslint/parser": "^7.1.1",
		"@vitest/coverage-v8": "^4.1.5",
		"cross-env": "^7.0.3",
		"drizzle-kit": "^1.0.0-beta.22",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-perfectionist": "^5.8.0",
		"eslint-plugin-prettier": "^5.1.3",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.2.5",
		"source-map-support": "^0.5.21",
		"sql-formatter": "^15.7.3",
		"supertest": "^6.3.4",
		"ts-jest": "^29.1.2",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.3.3",
		"unplugin-swc": "^1.5.9",
		"vitest": "^4.1.5",
		"wait-on": "^9.0.5"
	}
}
